### ============================================
### 功能点 F10：全链路数据感知 — 编译器报错日志感知
### 对应任务书：3b - 智能助教设计与实现
### 对应代码：elysia-backend/router/conversation.go (buildSystemPrompt -> judgeResult)
### ============================================

@baseUrl = http://localhost:8001
@contentType = application/json


### ============================================
### E2E-F10-01 运行记录加入对话（编译错误）
### 功能点：验证编译错误日志可传递给 AI 分析
### 前置条件：学生提交代码后出现编译错误
### 预期结果：AI 分析编译错误原因，给出修改建议
### ============================================

POST {{baseUrl}}/api/student/ai/chat
Content-Type: {{contentType}}
Authorization: Bearer {{studentToken}}

{
  "session_id": "",
  "problem_id": {{testProblemId}},
  "question_type": "algorithm_problem",
  "problem_info": {
    "id": {{testProblemId}},
    "title": "两数之和",
    "difficulty": "easy",
    "description": "给定一个整数数组 nums 和一个整数目标值 target"
  },
  "user_code": "#include <iostream>\nusing namespace std;\nint main() {\n    int n target;  // 缺少逗号\n    cin >> n >> target;\n    return 0\n}",
  "user_code_lang": "cpp",
  "judge_result": "compile_error",
  "messages": [
    {
      "role": "user",
      "content": "我的代码编译报错了，能帮我看看是什么原因吗？"
    }
  ]
}

> {%
  client.test("E2E-F10-01: 编译错误日志感知", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    // AI 应分析编译错误原因
  });
%}


### ============================================
### E2E-F10-02 运行记录加入对话（运行时错误）
### 功能点：验证运行时错误信息可传递给 AI
### 前置条件：学生代码运行时出错
### 预期结果：AI 分析运行时错误原因
### ============================================

POST {{baseUrl}}/api/student/ai/chat
Content-Type: {{contentType}}
Authorization: Bearer {{studentToken}}

{
  "session_id": "",
  "problem_id": {{testProblemId}},
  "question_type": "algorithm_problem",
  "problem_info": {
    "id": {{testProblemId}},
    "title": "两数之和",
    "difficulty": "easy",
    "description": "给定一个整数数组 nums 和一个整数目标值 target"
  },
  "user_code": "#include <iostream>\nusing namespace std;\nint main() {\n    int n, target;\n    cin >> n >> target;\n    int* arr = new int[n];\n    for (int i = 0; i <= n; i++) cin >> arr[i];  // 数组越界\n    delete[] arr;\n    return 0;\n}",
  "user_code_lang": "cpp",
  "judge_result": "runtime_error",
  "messages": [
    {
      "role": "user",
      "content": "我的代码运行时出错了，提示段错误，这是什么原因？"
    }
  ]
}

> {%
  client.test("E2E-F10-02: 运行时错误感知", function() {
    client.assert(response.status === 200, "HTTP状态码应为200");
    // AI 应分析运行时错误原因
  });
%}
